<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Plugin specific properties -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>Fiat on-ramp</Product>
    <Description>Walks customers who have no Bitcoin through buying it with a card, Apple Pay, Google Pay, PayPal, bank transfer or cash at an on-ramp (MoonPay, Paybis, Mercuryo, Transak...) and sending it to the invoice: one screen at a time, with screenshots or videos, Copy buttons and a fee check. Providers are filtered by the customer's region and the payment method named in the checkout link (#credit-card, #apple-pay...).</Description>
    <Version>0.2.2</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Plugin development properties -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- This will make sure that referencing BTCPayServer doesn't put any artifact in the published directory -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

</Project>
