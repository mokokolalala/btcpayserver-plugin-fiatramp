@using System
@using System.Linq
@model FiatRampSettings
@{
    ViewData.SetLayoutModel(new LayoutModel(Plugin.Area, "Fiat on-ramp").SetCategory(WellKnownCategories.Store));
    var allMethods = PayMethodInfo.All;
    var allRegions = new[] { Region.EU, Region.US, Region.Other };
    var signings = Enum.GetValues<UrlSigning>();
    var copies = new[] { ("", "nothing"), ("fiat", "amount to buy (fiat, incl. buffer)"), ("btc", "amount in BTC"), ("address", "Bitcoin address") };
    var kinds = new[] { "open", "signin", "amount", "address", "check", "pay", "wait", "info" };
    var checkoutExample = Url.Action("Checkout", "UIInvoice", new { area = "", invoiceId = "INVOICE_ID" }, Context.Request.Scheme);
    var nextOrder = Model.Providers.Count == 0 ? 0 : Model.Providers.Max(p => p.Order) + 1;
}

@section PageFootContent {
    <script>
        (function () {
            const list = document.getElementById('ProviderList');
            const providerTpl = document.getElementById('ProviderTemplate').innerHTML;
            const stepTpl = document.getElementById('StepTemplate').innerHTML;
            let n = 0;
            const uid = () => 'n' + (n++) + Date.now().toString(36);
            const fromHtml = html => { const w = document.createElement('div'); w.innerHTML = html.trim(); return w.firstElementChild; };

            document.getElementById('AddProvider').addEventListener('click', function () {
                list.appendChild(fromHtml(providerTpl.replace(/__KEY__/g, uid())));
            });
            list.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-action]');
                if (!btn) return;
                e.preventDefault();
                const action = btn.dataset.action;
                if (action === 'remove-provider') { btn.closest('.fr-provider').remove(); return; }
                if (action === 'toggle-secret') { const i = btn.closest('.input-group').querySelector('input'); i.type = i.type === 'password' ? 'text' : 'password'; return; }
                if (action === 'add-step') {
                    const provider = btn.closest('.fr-provider');
                    const key = provider.dataset.key;
                    provider.querySelector('.fr-steps').appendChild(fromHtml(stepTpl.replace(/__KEY__/g, key).replace(/__S__/g, uid())));
                    return;
                }
                const step = btn.closest('.fr-step');
                if (!step) return;
                if (action === 'remove-step') step.remove();
                else if (action === 'step-up' && step.previousElementSibling) step.parentElement.insertBefore(step, step.previousElementSibling);
                else if (action === 'step-down' && step.nextElementSibling) step.parentElement.insertBefore(step.nextElementSibling, step);
            });
        })();
    </script>
}

<form method="post">
    <div class="sticky-header">
        <vc:title-header />
        <button id="page-primary" type="submit" name="command" value="save" class="btn btn-primary">Save</button>
    </div>
    <partial name="_StatusMessage" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-xxl-constrain col-xl-10">

            <div class="settings-section">
                <h3 class="mb-3">Checkout</h3>
                <div class="form-check mb-3">
                    <input asp-for="Enabled" type="checkbox" class="form-check-input" />
                    <label asp-for="Enabled" class="form-check-label">Show "Buy Bitcoin and pay" on the Bitcoin (on-chain) checkout</label>
                </div>
                <div class="form-group">
                    <label asp-for="Headline" class="form-label">Headline</label>
                    <input asp-for="Headline" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Intro" class="form-label">Intro text</label>
                    <textarea asp-for="Intro" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="BufferPercent" class="form-label">Buffer (%)</label>
                    <input asp-for="BufferPercent" type="number" step="0.5" min="0" max="50" class="form-control" style="max-width:8rem" />
                    <div class="form-text">The customer is told to buy the due amount plus this percentage, so the provider's fee and the network fee don't leave the invoice short.</div>
                    <span asp-validation-for="BufferPercent" class="text-danger"></span>
                </div>
            </div>

            <div class="settings-section">
                <h3 class="mb-3">Region detection</h3>
                <div class="form-check mb-3">
                    <input asp-for="GeoLookupEnabled" type="checkbox" class="form-check-input" />
                    <label asp-for="GeoLookupEnabled" class="form-check-label">Look up the customer's country from their IP address</label>
                </div>
                <div class="form-group">
                    <label asp-for="GeoLookupUrl" class="form-label">Lookup URL</label>
                    <input asp-for="GeoLookupUrl" class="form-control" />
                    <div class="form-text">
                        A GET endpoint that returns the two-letter country code, as plain text or JSON (<code>country_code</code>, <code>countryCode</code> or <code>country</code>). <code>{ip}</code> is replaced with the customer's IP.
                        Results are cached for 24 hours. EU = EU-27, EEA, UK and Switzerland. When the lookup fails, the browser's timezone is used as a fallback.
                    </div>
                    <span asp-validation-for="GeoLookupUrl" class="text-danger"></span>
                </div>
            </div>

            <div class="settings-section">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="mb-0">Providers</h3>
                    <div class="d-flex gap-2">
                        <button type="submit" name="command" value="reset-providers" class="btn btn-outline-secondary btn-sm">Reset to defaults</button>
                        <button type="button" id="AddProvider" class="btn btn-secondary btn-sm">Add provider</button>
                    </div>
                </div>
                <p class="text-secondary">
                    Each provider is a public link the customer opens with their own account; no partner key is needed. Where the site accepts it, the amount is put in the link.
                    The customer then follows the <strong>steps</strong> you define here, one screen at a time, with a Copy button on the step that needs the amount or the address and a
                    "what you receive" check before paying. Placeholders in the URL: <code>{fiat}</code> <code>{btc}</code> <code>{currency}</code> <code>{currency_lower}</code> <code>{address}</code> <code>{store}</code> <code>{invoiceId}</code> <code>{returnUrl}</code> <code>{apiKey}</code>.
                    In step texts: <code>{buy}</code> <code>{btc}</code> <code>{address}</code> <code>{address_short}</code> <code>{provider}</code>.
                </p>

                <div id="ProviderList">
                    @for (var i = 0; i < Model.Providers.Count; i++)
                    {
                        var p = Model.Providers[i];
                        var k = i.ToString();
                        var steps = p.EffectiveSteps().ToList();
                        <div class="fr-provider card mb-3" data-key="@k">
                            <div class="card-body">
                                <input type="hidden" name="Providers.Index" value="@k" />
                                <input type="hidden" name="Providers[@k].Id" value="@p.Id" />
                                <div class="row g-3">
                                    <div class="col-md-5">
                                        <label class="form-label">Name</label>
                                        <input name="Providers[@k].Name" value="@p.Name" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Order</label>
                                        <input name="Providers[@k].Order" value="@p.Order" type="number" class="form-control" />
                                    </div>
                                    <div class="col-md-5 d-flex align-items-end justify-content-between">
                                        <div class="form-check">
                                            <input type="checkbox" name="Providers[@k].Enabled" value="true" class="form-check-input" id="en_@k" checked="@p.Enabled" />
                                            <input type="hidden" name="Providers[@k].Enabled" value="false" />
                                            <label class="form-check-label" for="en_@k">Enabled</label>
                                        </div>
                                        <button type="button" class="btn btn-link text-danger p-0" data-action="remove-provider">Remove provider</button>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Link</label>
                                        <input name="Providers[@k].UrlTemplate" value="@p.UrlTemplate" class="form-control font-monospace" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label d-block">Payment methods</label>
                                        @foreach (var m in allMethods)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input type="checkbox" name="Providers[@k].Methods" value="@m.Method" class="form-check-input" id="m_@(k)_@m.Method" checked="@p.Methods.Contains(m.Method)" />
                                                <label class="form-check-label" for="m_@(k)_@m.Method">@m.Label</label>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label d-block">Regions</label>
                                        @foreach (var r in allRegions)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input type="checkbox" name="Providers[@k].Regions" value="@r" class="form-check-input" id="r_@(k)_@r" checked="@p.Regions.Contains(r)" />
                                                <label class="form-check-label" for="r_@(k)_@r">@r</label>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Note on the card</label>
                                        <input name="Providers[@k].Note" value="@p.Note" class="form-control" />
                                    </div>

                                    <div class="col-12">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label class="form-label mb-0">Steps <small class="text-muted">(shown as a slider, in this order)</small></label>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="add-step">Add step</button>
                                        </div>
                                        <div class="fr-steps">
                                            @for (var j = 0; j < steps.Count; j++)
                                            {
                                                var s = steps[j];
                                                var sk = j.ToString();
                                                <div class="fr-step border rounded p-2 mb-2">
                                                    <input type="hidden" name="Providers[@k].Steps.Index" value="@sk" />
                                                    <div class="row g-2 align-items-start">
                                                        <div class="col-md-7">
                                                            <textarea name="Providers[@k].Steps[@sk].Text" class="form-control" rows="2" placeholder="What the customer does on this screen">@s.Text</textarea>
                                                        </div>
                                                        <div class="col-md-5">
                                                            <input name="Providers[@k].Steps[@sk].ImageUrl" value="@s.ImageUrl" class="form-control form-control-sm mb-1" placeholder="Screenshot or video URL (https; image, .mp4, YouTube, Vimeo)" />
                                                            <div class="d-flex gap-1">
                                                                <select name="Providers[@k].Steps[@sk].Copy" class="form-select form-select-sm" title="Copy button on this step">
                                                                    @foreach (var (val, label) in copies)
                                                                    {
                                                                        <option value="@val" selected="@((s.Copy ?? "") == val)">Copy: @label</option>
                                                                    }
                                                                </select>
                                                                <select name="Providers[@k].Steps[@sk].Kind" class="form-select form-select-sm" title="Drawn illustration when there is no screenshot" style="max-width:7rem">
                                                                    @foreach (var kind in kinds)
                                                                    {
                                                                        <option value="@kind" selected="@((s.Kind ?? "info") == kind)">@kind</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                                                            <div class="form-check form-check-inline m-0">
                                                                <input type="checkbox" name="Providers[@k].Steps[@sk].Open" value="true" class="form-check-input" id="so_@(k)_@sk" checked="@s.Open" />
                                                                <input type="hidden" name="Providers[@k].Steps[@sk].Open" value="false" />
                                                                <label class="form-check-label" for="so_@(k)_@sk">"Open provider" button</label>
                                                            </div>
                                                            <div class="form-check form-check-inline m-0">
                                                                <input type="checkbox" name="Providers[@k].Steps[@sk].Check" value="true" class="form-check-input" id="sc_@(k)_@sk" checked="@s.Check" />
                                                                <input type="hidden" name="Providers[@k].Steps[@sk].Check" value="false" />
                                                                <label class="form-check-label" for="sc_@(k)_@sk">"You receive" check</label>
                                                            </div>
                                                            <span class="ms-auto d-flex gap-2">
                                                                <button type="button" class="btn btn-link btn-sm p-0" data-action="step-up" title="Move up">&uarr;</button>
                                                                <button type="button" class="btn btn-link btn-sm p-0" data-action="step-down" title="Move down">&darr;</button>
                                                                <button type="button" class="btn btn-link btn-sm p-0 text-danger" data-action="remove-step">Remove</button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <details>
                                            <summary class="text-secondary small">Partner key and signing (only for providers that gave you one)</summary>
                                            <div class="row g-3 mt-0">
                                                <div class="col-md-4">
                                                    <label class="form-label">API key / partner ID <small class="text-muted">({apiKey})</small></label>
                                                    <input name="Providers[@k].ApiKey" value="@p.ApiKey" class="form-control" autocomplete="off" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Secret <small class="text-muted">(signing only)</small></label>
                                                    <div class="input-group">
                                                        <input name="Providers[@k].Secret" value="@p.Secret" type="password" class="form-control" autocomplete="new-password" />
                                                        <button type="button" class="btn btn-outline-secondary" data-action="toggle-secret">Show</button>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Signing</label>
                                                    <select name="Providers[@k].Signing" class="form-select">
                                                        @foreach (var sg in signings)
                                                        {
                                                            <option value="@sg" selected="@(sg == p.Signing)">@sg</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="settings-section">
                <h3 class="mb-3">How to use from your shop</h3>
                <p>
                    Send the customer to the normal BTCPay checkout link. To open the walkthrough on a specific payment method, add a hash to the link:
                </p>
                <ul class="mb-3">
                    @foreach (var m in allMethods)
                    {
                        <li><code>@(checkoutExample)#@m.Slug</code> &rarr; @m.Label</li>
                    }
                </ul>
                <p class="mb-0">
                    <code>?method=credit-card</code> works too. Add <code>?region=eu</code> or <code>?region=us</code> to override the detected region, which is handy for testing.
                </p>
            </div>
        </div>
    </div>
</form>

<template id="ProviderTemplate">
    <div class="fr-provider card mb-3" data-key="__KEY__">
        <div class="card-body">
            <input type="hidden" name="Providers.Index" value="__KEY__" />
            <input type="hidden" name="Providers[__KEY__].Id" value="" />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Name</label>
                    <input name="Providers[__KEY__].Name" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Order</label>
                    <input name="Providers[__KEY__].Order" value="@nextOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-5 d-flex align-items-end justify-content-between">
                    <div class="form-check">
                        <input type="checkbox" name="Providers[__KEY__].Enabled" value="true" class="form-check-input" id="en___KEY__" checked />
                        <input type="hidden" name="Providers[__KEY__].Enabled" value="false" />
                        <label class="form-check-label" for="en___KEY__">Enabled</label>
                    </div>
                    <button type="button" class="btn btn-link text-danger p-0" data-action="remove-provider">Remove provider</button>
                </div>
                <div class="col-12">
                    <label class="form-label">Link</label>
                    <input name="Providers[__KEY__].UrlTemplate" class="form-control font-monospace" placeholder="https://example.com/buy?currency={currency}&amp;amount={fiat}" />
                </div>
                <div class="col-md-6">
                    <label class="form-label d-block">Payment methods</label>
                    @foreach (var m in allMethods)
                    {
                        <div class="form-check form-check-inline">
                            <input type="checkbox" name="Providers[__KEY__].Methods" value="@m.Method" class="form-check-input" id="m___KEY___@m.Method" />
                            <label class="form-check-label" for="m___KEY___@m.Method">@m.Label</label>
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block">Regions</label>
                    @foreach (var r in allRegions)
                    {
                        <div class="form-check form-check-inline">
                            <input type="checkbox" name="Providers[__KEY__].Regions" value="@r" class="form-check-input" id="r___KEY___@r" checked />
                            <label class="form-check-label" for="r___KEY___@r">@r</label>
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">Note on the card</label>
                    <input name="Providers[__KEY__].Note" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label mb-0">Steps <small class="text-muted">(shown as a slider, in this order)</small></label>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="add-step">Add step</button>
                    </div>
                    <div class="fr-steps"></div>
                </div>
                <div class="col-12">
                    <details>
                        <summary class="text-secondary small">Partner key and signing (only for providers that gave you one)</summary>
                        <div class="row g-3 mt-0">
                            <div class="col-md-4">
                                <label class="form-label">API key / partner ID <small class="text-muted">({apiKey})</small></label>
                                <input name="Providers[__KEY__].ApiKey" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Secret <small class="text-muted">(signing only)</small></label>
                                <div class="input-group">
                                    <input name="Providers[__KEY__].Secret" type="password" class="form-control" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" data-action="toggle-secret">Show</button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Signing</label>
                                <select name="Providers[__KEY__].Signing" class="form-select">
                                    @foreach (var sg in signings)
                                    {
                                        <option value="@sg">@sg</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</template>

<template id="StepTemplate">
    <div class="fr-step border rounded p-2 mb-2">
        <input type="hidden" name="Providers[__KEY__].Steps.Index" value="__S__" />
        <div class="row g-2 align-items-start">
            <div class="col-md-7">
                <textarea name="Providers[__KEY__].Steps[__S__].Text" class="form-control" rows="2" placeholder="What the customer does on this screen"></textarea>
            </div>
            <div class="col-md-5">
                <input name="Providers[__KEY__].Steps[__S__].ImageUrl" class="form-control form-control-sm mb-1" placeholder="Screenshot or video URL (https; image, .mp4, YouTube, Vimeo)" />
                <div class="d-flex gap-1">
                    <select name="Providers[__KEY__].Steps[__S__].Copy" class="form-select form-select-sm" title="Copy button on this step">
                        @foreach (var (val, label) in copies)
                        {
                            <option value="@val">Copy: @label</option>
                        }
                    </select>
                    <select name="Providers[__KEY__].Steps[__S__].Kind" class="form-select form-select-sm" title="Drawn illustration when there is no screenshot" style="max-width:7rem">
                        @foreach (var kind in kinds)
                        {
                            <option value="@kind" selected="@(kind == "info")">@kind</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                <div class="form-check form-check-inline m-0">
                    <input type="checkbox" name="Providers[__KEY__].Steps[__S__].Open" value="true" class="form-check-input" id="so___KEY_____S__" />
                    <input type="hidden" name="Providers[__KEY__].Steps[__S__].Open" value="false" />
                    <label class="form-check-label" for="so___KEY_____S__">"Open provider" button</label>
                </div>
                <div class="form-check form-check-inline m-0">
                    <input type="checkbox" name="Providers[__KEY__].Steps[__S__].Check" value="true" class="form-check-input" id="sc___KEY_____S__" />
                    <input type="hidden" name="Providers[__KEY__].Steps[__S__].Check" value="false" />
                    <label class="form-check-label" for="sc___KEY_____S__">"You receive" check</label>
                </div>
                <span class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-link btn-sm p-0" data-action="step-up" title="Move up">&uarr;</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-action="step-down" title="Move down">&darr;</button>
                    <button type="button" class="btn btn-link btn-sm p-0 text-danger" data-action="remove-step">Remove</button>
                </span>
            </div>
        </div>
    </div>
</template>
