@using System.Linq
@using BTCPayServer
@using BTCPayServer.Plugins.FiatRamp
@using BTCPayServer.Plugins.FiatRamp.Services
@model BTCPayServer.Models.InvoicingModels.CheckoutModel
@inject FiatRampSettingsService SettingsService
@inject GeoRegionService Geo
@inject BTCPayServer.Services.Invoices.InvoiceRepository InvoiceRepository
@inject BTCPayServer.Abstractions.Services.Safe Safe
@{
    Layout = null;
    var settings = await SettingsService.Get(Model.StoreId);
    object config;
    if (!settings.Enabled)
    {
        config = new { enabled = false };
    }
    else
    {
        var invoice = await InvoiceRepository.GetInvoice(Model.InvoiceId);
        var geo = await Geo.LookupAsync(Context.Connection.RemoteIpAddress, settings, Context.RequestAborted);
        var currency = invoice?.Currency ?? "";
        var isCrypto = currency.Equals("BTC", StringComparison.OrdinalIgnoreCase) || currency.Equals("SATS", StringComparison.OrdinalIgnoreCase);
        config = new
        {
            enabled = true,
            headline = settings.Headline,
            intro = settings.Intro,
            bufferPercent = settings.BufferPercent,
            region = geo.Region?.ToString() ?? "Unknown",
            country = geo.Country,
            fiatCurrency = isCrypto ? null : currency,
            fiatTotal = isCrypto ? 0m : (invoice?.Price ?? 0m),
            methods = PayMethodInfo.All.Select(m => new { id = m.Method.ToString(), slug = m.Slug, label = m.Label, aliases = m.Aliases }),
            providers = settings.Providers
                .Where(p => p.IsUsable)
                .OrderBy(p => p.Order)
                .Select(p => new
                {
                    id = p.Id,
                    name = p.Name,
                    note = p.Note,
                    methods = p.Methods.Select(m => m.ToString()),
                    regions = p.Regions.Select(r => r.ToString()),
                    steps = p.EffectiveSteps().Select(s => new { text = s.Text, image = s.ImageUrl, copy = s.Copy, open = s.Open, check = s.Check, kind = s.Kind }),
                    url = Url.Action("Go", "FiatRamp", new { area = Plugin.Area, invoiceId = Model.InvoiceId, providerId = p.Id })
                })
        };
    }
}
<template id="fiatramp-template">
    <div v-if="visible" class="fiatramp" :class="{ 'fiatramp--focus': focus }" id="FiatRamp">

        <!-- ============ FOCUS MODE: the customer arrived to pay with a card, Apple/Google Pay, PayPal, bank or cash ============ -->
        <template v-if="focus">
            <div class="fiatramp__hero">
                <div class="fiatramp__hero-label">Pay with <span v-text="methodLabel"></span></div>
                <div class="fiatramp__hero-amount" v-if="fiatDue > 0"><span v-text="fmt(fiatDue)"></span> <small v-text="cfg.fiatCurrency"></small></div>
                <div class="fiatramp__hero-amount" v-else><span v-text="model.due"></span> <small v-text="model.paymentMethodCurrency"></small></div>
                <div class="fiatramp__hero-sub">About 10 minutes. You buy Bitcoin for this amount at a provider and send it to this order. We walk you through every screen.</div>
            </div>

            <div class="fiatramp__methods" role="tablist">
                <button v-for="m in methodChoices" :key="m.id" type="button" class="fiatramp__method" role="tab"
                        :class="{ active: method === m.id }" :aria-selected="method === m.id ? 'true' : 'false'"
                        v-on:click="select(m.id)" v-text="m.label"></button>
            </div>

            <!-- Provider picker -->
            <section class="fiatramp__step">
                <div class="fiatramp__step-head"><h6>Where do you want to buy?</h6><span class="fiatramp__region" v-if="region !== 'Unknown'" v-text="regionLabel"></span></div>
                <div v-if="providers.length" class="fiatramp__providers">
                    <button v-for="p in providers" :key="p.id" type="button" class="fiatramp__provider" :class="{ active: activeProvider === p.id }"
                            v-on:click="pick(p.id)" :aria-pressed="activeProvider === p.id ? 'true' : 'false'">
                        <span class="fiatramp__provider-name" v-text="p.name"></span>
                        <small v-if="p.note" v-text="p.note"></small>
                    </button>
                </div>
                <div v-else class="fiatramp__empty">No provider is available for <span v-text="methodLabel"></span> in your region yet. Try another method above.</div>
            </section>

            <!-- Walkthrough: one screen per step, like a gallery -->
            <section class="fiatramp__step" v-if="current">
                <div class="fiatramp__step-head"><h6>How to pay at <span v-text="current.name"></span></h6><span class="fiatramp__counter">Step <span v-text="slide + 1"></span> of <span v-text="current.steps.length"></span></span></div>

                <div class="fiatramp__slider" tabindex="0" v-on:keydown.left.prevent="prev()" v-on:keydown.right.prevent="next()" v-on:touchstart="touchStart" v-on:touchend="touchEnd" aria-roledescription="carousel">
                    <div class="fiatramp__shot">
                        <img :src="step.image || illus(step)" :alt="'Step ' + (slide + 1)" />
                        <button type="button" class="fiatramp__arrow fiatramp__arrow--prev" v-on:click="prev()" :disabled="slide === 0" aria-label="Previous step">&lsaquo;</button>
                        <button type="button" class="fiatramp__arrow fiatramp__arrow--next" v-on:click="next()" :disabled="slide === current.steps.length - 1" aria-label="Next step">&rsaquo;</button>
                    </div>
                    <div class="fiatramp__dots" role="tablist">
                        <button v-for="(s, i) in current.steps" :key="i" type="button" class="fiatramp__dot-btn" :class="{ active: i === slide, done: i < slide }" v-on:click="slide = i" :aria-label="'Step ' + (i + 1)"></button>
                    </div>

                    <div class="fiatramp__slide-body">
                        <p class="fiatramp__slide-text" v-text="fill(step.text)"></p>

                        <!-- what to copy on this step -->
                        <div v-if="step.copy" class="fiatramp__chip">
                            <span class="fiatramp__chip-label" v-text="copyLabel(step.copy)"></span>
                            <code class="fiatramp__chip-value" v-text="copyValue(step.copy)"></code>
                            <button type="button" class="fiatramp__copy" :class="{ ok: copied[step.copy] }" v-on:click="copy(copyValue(step.copy), step.copy)" v-text="copied[step.copy] ? 'Copied' : 'Copy'"></button>
                        </div>
                        <button v-if="step.copy === 'address'" type="button" class="fiatramp__link" v-on:click="showQr = !showQr" v-text="showQr ? 'Hide QR code' : 'Show QR code instead'"></button>
                        <div v-if="step.copy === 'address' && showQr" class="fiatramp__qr"><qrcode :value="model.address" tag="div" :options="qrOptions"></qrcode></div>

                        <!-- the "did they take enough?" check, for providers that only let you type a fiat amount -->
                        <div v-if="step.check" class="fiatramp__check">
                            <label class="fiatramp__check-label" :for="'fiatramp-recv-' + current.id">The provider says you receive</label>
                            <div class="fiatramp__check-row">
                                <input :id="'fiatramp-recv-' + current.id" class="fiatramp__check-input" type="text" inputmode="decimal" placeholder="0.00000000" v-model="received" autocomplete="off" />
                                <span class="fiatramp__check-unit" v-text="model.paymentMethodCurrency"></span>
                            </div>
                            <div v-if="receivedNum > 0" class="fiatramp__verdict" :class="enough ? 'ok' : 'short'">
                                <template v-if="enough">That covers the order. You have <strong v-text="fmtBtc(receivedNum - dueBtc)"></strong> <span v-text="model.paymentMethodCurrency"></span> to spare. Go ahead and pay.</template>
                                <template v-else>Not enough: short by <strong v-text="fmtBtc(dueBtc - receivedNum)"></strong> <span v-text="model.paymentMethodCurrency"></span><template v-if="fiatDue > 0"> (about <strong v-text="fmt(shortFiat)"></strong> <span v-text="cfg.fiatCurrency"></span>)</template>. Go back, raise the amount by that much and check again.</template>
                            </div>
                            <div v-else class="fiatramp__tiny">You need at least <strong v-text="model.due"></strong> <span v-text="model.paymentMethodCurrency"></span> to arrive. Providers take their fee out of what you pay, so the "you receive" number is the one that counts.</div>
                        </div>

                        <a v-if="step.open" class="btn btn-primary rounded-pill w-100 fiatramp__go" :href="href(current)" target="_blank" rel="noopener noreferrer" v-on:click="opened = true">Open <span v-text="current.name"></span> in a new tab</a>

                        <div class="fiatramp__slide-nav">
                            <button type="button" class="fiatramp__nav" v-on:click="prev()" :disabled="slide === 0">Back</button>
                            <button type="button" class="fiatramp__nav fiatramp__nav--next" v-on:click="next()" v-if="slide < current.steps.length - 1">Next step</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Everything the provider may ask for, always at hand -->
            <section class="fiatramp__step fiatramp__details">
                <div class="fiatramp__step-head"><h6>Your details for the provider</h6></div>
                <div class="fiatramp__chip">
                    <span class="fiatramp__chip-label">Amount to buy</span>
                    <code class="fiatramp__chip-value"><span v-text="copyValue('fiat')"></span> <small v-text="fiatDue > 0 ? cfg.fiatCurrency : model.paymentMethodCurrency"></small></code>
                    <button type="button" class="fiatramp__copy" :class="{ ok: copied.fiat }" v-on:click="copy(copyValue('fiat'), 'fiat')" v-text="copied.fiat ? 'Copied' : 'Copy'"></button>
                </div>
                <div class="fiatramp__tiny" v-if="fiatDue > 0">The order is <strong v-text="`${model.due} ${model.paymentMethodCurrency}`"></strong>. The amount includes <span v-text="cfg.bufferPercent"></span>% for the provider's and the network's fees. A little more is fine; less leaves the order unpaid.</div>
                <div class="fiatramp__chip">
                    <span class="fiatramp__chip-label">Bitcoin address</span>
                    <code class="fiatramp__chip-value fiatramp__chip-value--addr" v-text="model.address"></code>
                    <button type="button" class="fiatramp__copy" :class="{ ok: copied.address }" v-on:click="copy(model.address, 'address')" v-text="copied.address ? 'Copied' : 'Copy'"></button>
                </div>
                <div class="fiatramp__tiny">Coin: <strong>Bitcoin (BTC)</strong>, <strong>Bitcoin network</strong>. Not Lightning, not "BTC on Ethereum".</div>
            </section>

            <!-- Live status -->
            <section class="fiatramp__step">
                <div class="fiatramp__status" :class="statusClass">
                    <span class="fiatramp__dot" aria-hidden="true"></span>
                    <span v-text="statusText"></span>
                </div>
                <div class="fiatramp__tiny">This page checks the blockchain every few seconds and updates by itself. A purchase usually shows up within 10 to 30 minutes of the provider confirming it.
                    <template v-if="model.storeSupportUrl"> Nothing after an hour? <a :href="model.storeSupportUrl" target="_blank" rel="noopener">Contact us</a> with your order number.</template>
                </div>
            </section>

            <button type="button" class="fiatramp__core-toggle" v-on:click="toggleCore" :aria-expanded="coreOpen ? 'true' : 'false'">
                <span v-text="coreOpen ? 'Hide the Bitcoin wallet option' : 'Already have Bitcoin? Pay from your wallet instead'"></span>
            </button>
        </template>

        <!-- ============ DEFAULT MODE: the regular Bitcoin checkout, with a compact on-ramp offer under it ============ -->
        <template v-else>
            <h6 v-text="cfg.headline"></h6>
            <div class="fiatramp__intro" v-text="cfg.intro"></div>
            <div class="fiatramp__methods">
                <button v-for="m in methodChoices" :key="m.id" type="button" class="fiatramp__method" v-on:click="enterFocus(m.id)" v-text="m.label"></button>
            </div>
        </template>
    </div>
</template>

<style>
    /* Layout: the panel is a column of sections inside BTCPay's tile; colors come from BTCPay's theme variables. */
    .fiatramp { margin-top: var(--btcpay-space-l); padding-top: var(--btcpay-space-l); border-top: 1px solid var(--btcpay-body-border-light); text-align: start; }
    .fiatramp--focus { margin-top: 0; padding-top: 0; border-top: none; }
    .fiatramp h6 { margin: 0; font-weight: var(--btcpay-font-weight-semibold); }
    .fiatramp > h6 { margin-bottom: var(--btcpay-space-xs); text-align: center; }
    .fiatramp__intro { font-size: var(--btcpay-font-size-s); color: var(--btcpay-body-text-muted); text-align: center; margin-bottom: var(--btcpay-space-m); }

    .fiatramp__hero { text-align: center; padding: var(--btcpay-space-s) 0 var(--btcpay-space-m); }
    .fiatramp__hero-label { font-size: var(--btcpay-font-size-s); color: var(--btcpay-body-text-muted); text-transform: uppercase; letter-spacing: .08em; }
    .fiatramp__hero-amount { font-size: 2.2rem; font-weight: var(--btcpay-font-weight-semibold); line-height: 1.15; margin: .15rem 0; font-variant-numeric: tabular-nums; }
    .fiatramp__hero-amount small { font-size: 1rem; color: var(--btcpay-body-text-muted); font-weight: var(--btcpay-font-weight-normal); }
    .fiatramp__hero-sub { font-size: var(--btcpay-font-size-s); color: var(--btcpay-body-text-muted); max-width: 36ch; margin: 0 auto; line-height: 1.45; }

    .fiatramp__methods { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--btcpay-space-xs); margin-bottom: var(--btcpay-space-m); }
    .fiatramp__method { padding: .3rem .8rem; font-size: var(--btcpay-font-size-s); border: 1px solid var(--btcpay-body-border-medium); border-radius: 2rem; background: none; color: var(--btcpay-body-text-muted); cursor: pointer; }
    .fiatramp__method:hover { color: var(--btcpay-body-text); border-color: var(--btcpay-body-text-muted); }
    .fiatramp__method.active { background: var(--btcpay-primary); border-color: var(--btcpay-primary); color: var(--btcpay-white); }
    .fiatramp :is(button, a, input, [tabindex]):focus-visible { outline: 2px solid var(--btcpay-primary); outline-offset: 2px; }

    .fiatramp__step { padding: var(--btcpay-space-m) 0; border-top: 1px solid var(--btcpay-body-border-light); }
    .fiatramp__step-head { display: flex; align-items: center; gap: var(--btcpay-space-s); margin-bottom: var(--btcpay-space-s); }
    .fiatramp__region, .fiatramp__counter { margin-inline-start: auto; font-size: .7rem; color: var(--btcpay-body-text-muted); border: 1px solid var(--btcpay-body-border-light); border-radius: 1rem; padding: .05rem .5rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .fiatramp__tiny { font-size: .78rem; color: var(--btcpay-body-text-muted); line-height: 1.45; margin-top: var(--btcpay-space-xs); }
    .fiatramp__tiny a { color: inherit; }
    .fiatramp__empty { font-size: var(--btcpay-font-size-s); color: var(--btcpay-body-text-muted); padding: var(--btcpay-space-s) 0; }

    /* provider picker: a grid of cards */
    .fiatramp__providers { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--btcpay-space-xs); }
    .fiatramp__provider { display: flex; flex-direction: column; gap: .1rem; padding: .55rem .7rem; border: 1px solid var(--btcpay-body-border-medium); border-radius: var(--border-radius); background: var(--btcpay-body-bg); color: var(--btcpay-body-text); text-align: start; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .fiatramp__provider:hover { border-color: var(--btcpay-body-text-muted); }
    .fiatramp__provider.active { border-color: var(--btcpay-primary); box-shadow: inset 0 0 0 1px var(--btcpay-primary); }
    .fiatramp__provider-name { font-weight: var(--btcpay-font-weight-semibold); font-size: var(--btcpay-font-size-s); }
    .fiatramp__provider small { color: var(--btcpay-body-text-muted); font-size: .7rem; line-height: 1.3; }

    /* the walkthrough slider */
    .fiatramp__slider { border: 1px solid var(--btcpay-body-border-medium); border-radius: var(--border-radius); background: var(--btcpay-body-bg); overflow: hidden; }
    .fiatramp__shot { position: relative; height: 230px; background: #14161c; }
    .fiatramp__shot img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .fiatramp__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 2.2rem; height: 2.2rem; border-radius: 50%; border: none; background: rgba(255,255,255,.92); color: #111; font-size: 1.6rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 4px rgba(0,0,0,.35); }
    .fiatramp__arrow--prev { left: .5rem; } .fiatramp__arrow--next { right: .5rem; }
    .fiatramp__arrow:disabled { opacity: .25; cursor: default; }
    .fiatramp__dots { display: flex; justify-content: center; gap: .35rem; padding: .55rem 0 0; }
    .fiatramp__dot-btn { width: .5rem; height: .5rem; padding: 0; border-radius: 50%; border: none; background: var(--btcpay-body-border-medium); cursor: pointer; }
    .fiatramp__dot-btn.done { background: var(--btcpay-body-text-muted); }
    .fiatramp__dot-btn.active { background: var(--btcpay-primary); transform: scale(1.3); }
    .fiatramp__slide-body { padding: .6rem .8rem .8rem; }
    .fiatramp__slide-text { margin: 0 0 var(--btcpay-space-s); font-size: var(--btcpay-font-size-s); line-height: 1.5; }
    .fiatramp__slide-nav { display: flex; justify-content: space-between; gap: var(--btcpay-space-s); margin-top: var(--btcpay-space-s); }
    .fiatramp__nav { padding: .35rem .9rem; font-size: var(--btcpay-font-size-s); border: 1px solid var(--btcpay-body-border-medium); border-radius: 2rem; background: none; color: var(--btcpay-body-text); cursor: pointer; }
    .fiatramp__nav:disabled { opacity: .35; cursor: default; }
    .fiatramp__nav--next { margin-inline-start: auto; border-color: var(--btcpay-primary); color: var(--btcpay-primary); font-weight: var(--btcpay-font-weight-semibold); }
    .fiatramp__go { margin-top: var(--btcpay-space-xs); }

    /* copy chips: label, value, button */
    .fiatramp__chip { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "label btn" "value btn"; align-items: center; gap: 0 var(--btcpay-space-s); padding: .45rem .6rem; margin-top: var(--btcpay-space-xs); border: 1px solid var(--btcpay-body-border-light); border-radius: var(--border-radius); background: var(--btcpay-bg-tile, var(--btcpay-body-bg)); }
    .fiatramp__chip-label { grid-area: label; font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--btcpay-body-text-muted); }
    .fiatramp__chip-value { grid-area: value; font-size: 1.05rem; font-weight: var(--btcpay-font-weight-semibold); color: var(--btcpay-primary); font-variant-numeric: tabular-nums; word-break: break-all; line-height: 1.3; }
    .fiatramp__chip-value small { font-size: .8rem; color: var(--btcpay-body-text-muted); font-weight: var(--btcpay-font-weight-normal); }
    .fiatramp__chip-value--addr { font-size: .8rem; color: var(--btcpay-body-text); }
    .fiatramp__chip .fiatramp__copy { grid-area: btn; }
    .fiatramp__copy { flex-shrink: 0; padding: .25rem .8rem; font-size: .78rem; line-height: 1.4; border: 1px solid var(--btcpay-body-border-medium); border-radius: 1rem; background: none; color: var(--btcpay-body-text); cursor: pointer; }
    .fiatramp__copy:hover, .fiatramp__copy.ok { border-color: var(--btcpay-success); color: var(--btcpay-success); }
    .fiatramp__link { display: block; margin-top: var(--btcpay-space-xs); background: none; border: none; padding: 0; font-size: .78rem; color: var(--btcpay-primary); cursor: pointer; text-decoration: underline; }
    .fiatramp__qr { margin: var(--btcpay-space-s) auto 0; width: 160px; max-width: 100%; padding: 8px; background: #fff; border-radius: var(--border-radius); }
    .fiatramp__qr svg, .fiatramp__qr canvas { width: 100%; height: auto; display: block; }

    /* the "you receive" check */
    .fiatramp__check { margin-top: var(--btcpay-space-xs); }
    .fiatramp__check-label { display: block; font-size: .78rem; color: var(--btcpay-body-text-muted); margin-bottom: .2rem; }
    .fiatramp__check-row { display: flex; align-items: center; gap: var(--btcpay-space-xs); }
    .fiatramp__check-input { flex: 1; min-width: 0; font-size: 1.05rem; font-variant-numeric: tabular-nums; padding: .4rem .6rem; border: 1px solid var(--btcpay-body-border-medium); border-radius: var(--border-radius); background: var(--btcpay-body-bg); color: var(--btcpay-body-text); }
    .fiatramp__check-unit { font-size: var(--btcpay-font-size-s); color: var(--btcpay-body-text-muted); }
    .fiatramp__verdict { margin-top: var(--btcpay-space-xs); padding: .5rem .7rem; border-radius: var(--border-radius); font-size: .8rem; line-height: 1.45; border: 1px solid; }
    .fiatramp__verdict.ok { border-color: var(--btcpay-success); color: var(--btcpay-success); }
    .fiatramp__verdict.short { border-color: var(--btcpay-danger); color: var(--btcpay-danger); }

    .fiatramp__status { display: flex; align-items: center; gap: var(--btcpay-space-s); padding: .6rem .8rem; border-radius: var(--border-radius); background: var(--btcpay-body-bg); border: 1px solid var(--btcpay-body-border-light); font-size: var(--btcpay-font-size-s); }
    .fiatramp__dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--btcpay-body-text-muted); animation: fiatramp-pulse 1.6s infinite; flex-shrink: 0; }
    .fiatramp__status.seen { border-color: var(--btcpay-warning); } .fiatramp__status.seen .fiatramp__dot { background: var(--btcpay-warning); }
    .fiatramp__status.partial { border-color: var(--btcpay-danger); } .fiatramp__status.partial .fiatramp__dot { background: var(--btcpay-danger); animation: none; }
    @@keyframes fiatramp-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
    @@media (prefers-reduced-motion: reduce) { .fiatramp__dot { animation: none; } .fiatramp__dot-btn { transition: none; } }

    .fiatramp__core-toggle { display: block; width: 100%; margin-top: var(--btcpay-space-m); padding: .55rem; background: none; border: 1px dashed var(--btcpay-body-border-medium); border-radius: var(--border-radius); color: var(--btcpay-body-text-muted); font-size: var(--btcpay-font-size-s); cursor: pointer; }
    .fiatramp__core-toggle:hover { color: var(--btcpay-body-text); border-color: var(--btcpay-body-text-muted); }

    /* Focus mode re-arranges BTCPay's own page: the panel goes first, the Bitcoin pieces collapse until asked for. */
    .payment-box.fiatramp-focus > :not(.fiatramp) { display: none !important; }
    .payment-box.fiatramp-focus.fiatramp-core-open > :not(.fiatramp) { display: revert !important; }
    .payment-box.fiatramp-focus.fiatramp-core-open > .fiatramp { border-bottom: 1px solid var(--btcpay-body-border-light); margin-bottom: var(--btcpay-space-l); }
    #Checkout.fiatramp-focus #AmountDue, #Checkout.fiatramp-focus .payment-methods-wrapper { display: none !important; }
    #Checkout.fiatramp-focus.fiatramp-core-open #AmountDue, #Checkout.fiatramp-focus.fiatramp-core-open .payment-methods-wrapper { display: revert !important; }
</style>

<script>
(function () {
    const FIATRAMP_CONFIG = @Safe.Json(config);

    function normalizeRegion(value) {
        const v = (value || '').toString().trim().toLowerCase();
        if (v === 'eu' || v === 'europe') return 'EU';
        if (v === 'us' || v === 'usa') return 'US';
        if (v === 'other' || v === 'row') return 'Other';
        return null;
    }

    function guessRegion() {
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            if (tz.startsWith('Europe/')) return 'EU';
            if (tz.startsWith('America/')) return 'US';
            if (tz) return 'Other';
        } catch (e) {}
        const lang = (navigator.language || '').toLowerCase();
        if (lang.endsWith('-us')) return 'US';
        return null;
    }

    function methodFromUrl(methods) {
        const candidates = [];
        const hash = (location.hash || '').replace(/^#/, '').trim().toLowerCase();
        if (hash) candidates.push(hash);
        const q = new URLSearchParams(location.search).get('method');
        if (q) candidates.push(q.trim().toLowerCase());
        for (const c of candidates) {
            for (const m of methods) {
                if (c === m.slug || c === m.id.toLowerCase() || m.aliases.includes(c)) return m.id;
            }
        }
        return null;
    }

    // Drawn stand-ins for steps that have no screenshot yet: a generic phone screen showing what the step is about.
    // Real screenshots (per step, per provider) are set in the store's Fiat on-ramp settings and take precedence.
    function illustration(kind, text) {
        const esc = s => (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
        const t = esc(text);
        const frame = body => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 230" font-family="system-ui,Segoe UI,Helvetica,Arial,sans-serif">` +
            `<rect width="360" height="230" fill="#14161c"/><rect x="105" y="10" width="150" height="240" rx="18" fill="#22262f" stroke="#3a3f4b"/>` +
            `<rect x="118" y="24" width="124" height="6" rx="3" fill="#3a3f4b"/>${body}</svg>`;
        const field = (y, label, value, hi) => `<text x="124" y="${y}" font-size="7" fill="#9aa0ad">${esc(label)}</text>` +
            `<rect x="118" y="${y + 5}" width="124" height="22" rx="6" fill="#14161c" stroke="${hi ? '#51b13e' : '#3a3f4b'}" stroke-width="${hi ? 1.5 : 1}"/>` +
            `<text x="126" y="${y + 20}" font-size="9" font-weight="600" fill="${hi ? '#51b13e' : '#e8e8ec'}">${esc(value)}</text>`;
        const btn = (y, label, primary) => `<rect x="118" y="${y}" width="124" height="22" rx="11" fill="${primary ? '#51b13e' : '#2d323d'}"/>` +
            `<text x="180" y="${y + 15}" font-size="8.5" font-weight="600" text-anchor="middle" fill="${primary ? '#fff' : '#e8e8ec'}">${esc(label)}</text>`;
        const title = s => `<text x="180" y="52" font-size="10" font-weight="600" text-anchor="middle" fill="#e8e8ec">${esc(s)}</text>`;
        const arrow = (x, y) => `<path d="M${x} ${y} l-14 -7 v4 h-24 v6 h24 v4 z" fill="#51b13e"/>`;
        switch (kind) {
            case 'open': return frame(`<rect x="30" y="60" width="300" height="24" rx="6" fill="#2d323d"/><rect x="40" y="66" width="12" height="12" rx="3" fill="#51b13e"/><text x="60" y="77" font-size="9" fill="#e8e8ec">${t}</text><text x="180" y="130" font-size="9" text-anchor="middle" fill="#9aa0ad">opens in a new tab</text>${arrow(205, 150)}<text x="180" y="190" font-size="8" text-anchor="middle" fill="#9aa0ad">keep this page open too</text>`);
            case 'signin': return frame(title(t) + btn(70, 'Continue with Google') + btn(100, 'Continue with Apple') + btn(130, 'Continue with email', true) + `<text x="180" y="175" font-size="7" text-anchor="middle" fill="#9aa0ad">new customers verify an ID</text>`);
            case 'amount': return frame(title('Buy Bitcoin') + field(66, 'You pay', t, true) + field(108, 'You get', '≈ BTC', false) + btn(160, 'Continue', true));
            case 'address': return frame(title('Where to send it') + field(66, 'Wallet address', t, true) + `<text x="180" y="120" font-size="7.5" text-anchor="middle" fill="#9aa0ad">paste the copied address here</text>` + btn(160, 'Continue', true));
            case 'check': return frame(title('Order summary') + `<text x="124" y="80" font-size="8" fill="#9aa0ad">You pay</text><text x="236" y="80" font-size="8" text-anchor="end" fill="#e8e8ec">${t}</text><text x="124" y="98" font-size="8" fill="#9aa0ad">Fees</text><text x="236" y="98" font-size="8" text-anchor="end" fill="#e8e8ec">included</text><rect x="118" y="108" width="124" height="24" rx="6" fill="#14161c" stroke="#51b13e" stroke-width="1.5"/><text x="124" y="124" font-size="8" fill="#9aa0ad">You receive</text><text x="236" y="124" font-size="9" font-weight="600" text-anchor="end" fill="#51b13e">0.000… BTC</text>` + `<text x="180" y="150" font-size="7.5" text-anchor="middle" fill="#9aa0ad">type this number below</text>` + btn(165, 'Pay', true));
            case 'pay': return frame(title(t) + field(66, 'Card number', '•••• •••• •••• 4242', false) + field(108, 'Expiry / CVC', 'MM / YY   •••', false) + btn(160, 'Pay now', true));
            case 'wait': return frame(title('Purchase complete') + `<circle cx="180" cy="100" r="22" fill="none" stroke="#51b13e" stroke-width="3"/><path d="M169 100 l8 8 l15 -16" fill="none" stroke="#51b13e" stroke-width="3"/><text x="180" y="145" font-size="8.5" text-anchor="middle" fill="#e8e8ec">${t}</text><text x="180" y="160" font-size="7.5" text-anchor="middle" fill="#9aa0ad">come back to this page</text>`);
            default: return frame(title(t));
        }
    }

    // Mount point. We append the element to the on-chain checkout template ourselves instead of using the
    // "checkout-bitcoin-post-content" extension point: the core NFC plugin renders its tag there self-closing
    // (<lnurl-withdraw-checkout ... />), which HTML parsers don't honour, so anything rendered after it ends up
    // inside that component as slot content and is never instantiated. Runs before Vue initialises (i18n loads first).
    // When the link names a payment method, the panel is placed first and the page starts in focus mode.
    const startFocused = FIATRAMP_CONFIG.enabled && !!methodFromUrl(FIATRAMP_CONFIG.methods || []);
    (function mount() {
        const tpl = document.getElementById('BitcoinCheckoutBody');
        const root = tpl && (tpl.content || tpl);
        const box = root && root.querySelector('.payment-box');
        if (!box || box.querySelector(':scope > fiatramp-checkout')) return;
        const el = document.createElement('fiatramp-checkout');
        el.setAttribute(':model', 'model');
        if (startFocused) {
            box.classList.add('fiatramp-focus');
            box.insertBefore(el, box.firstChild);
        } else {
            box.appendChild(el);
        }
    })();

    Vue.component('fiatramp-checkout', {
        template: '#fiatramp-template',
        props: { model: Object },
        components: { qrcode: window.VueQrcode },
        data() {
            return {
                cfg: FIATRAMP_CONFIG,
                method: null,
                focus: false,
                coreOpen: false,
                activeProvider: null,
                slide: 0,
                received: '',
                opened: false,
                showQr: false,
                tzRegion: null,
                touchX: null,
                qrOptions: { margin: 0, width: 160, color: { dark: '#000', light: '#fff' } },
                copied: { address: false, fiat: false, btc: false }
            };
        },
        computed: {
            visible() {
                return this.cfg.enabled
                    && this.model && this.model.address
                    && this.model.paymentMethodId === 'BTC-CHAIN'
                    && this.providersForRegion.length > 0;
            },
            region() {
                const override = normalizeRegion(new URLSearchParams(location.search).get('region'));
                if (override) return override;
                if (this.cfg.region && this.cfg.region !== 'Unknown') return this.cfg.region;
                return this.tzRegion || 'Unknown';
            },
            regionLabel() {
                return { EU: 'Europe', US: 'United States', Other: 'your region' }[this.region] || '';
            },
            providersForRegion() {
                const r = this.region;
                return (this.cfg.providers || []).filter(p => r === 'Unknown' || !p.regions.length || p.regions.includes(r));
            },
            methodChoices() {
                return (this.cfg.methods || []).filter(m => this.providersForRegion.some(p => p.methods.includes(m.id)));
            },
            providers() {
                return this.providersForRegion.filter(p => !this.method || p.methods.includes(this.method));
            },
            current() {
                const p = this.providers.find(p => p.id === this.activeProvider);
                return p && p.steps && p.steps.length ? p : null;
            },
            step() { return this.current ? this.current.steps[Math.min(this.slide, this.current.steps.length - 1)] : null; },
            methodLabel() {
                const m = (this.cfg.methods || []).find(m => m.id === this.method);
                return m ? m.label : 'card';
            },
            dueBtc() { return this.asNumber(this.model.due) || 0; },
            totalBtc() { return this.asNumber(this.model.orderAmount) || 0; },
            paidBtc() { return this.asNumber(this.model.paid) || 0; },
            rate() { return this.cfg.fiatTotal && this.totalBtc ? this.cfg.fiatTotal / this.totalBtc : 0; },
            fiatDue() { return this.rate * this.dueBtc; },
            fiatBuy() { return this.fiatDue * (1 + (this.cfg.bufferPercent || 0) / 100); },
            receivedNum() { return this.asNumber(this.received) || 0; },
            enough() { return this.receivedNum >= this.dueBtc; },
            shortFiat() { return Math.max(0, this.dueBtc - this.receivedNum) * this.rate; },
            statusClass() {
                if (this.paidBtc > 0 && this.dueBtc > 0) return 'partial';
                if (this.model.status === 'Processing') return 'seen';
                return 'waiting';
            },
            statusText() {
                if (this.paidBtc > 0 && this.dueBtc > 0) {
                    return `Received ${this.model.paid} ${this.model.paymentMethodCurrency}, still missing ${this.model.due} ${this.model.paymentMethodCurrency}. The provider's fee was probably taken out of the amount. Please send the missing part to the same address.`;
                }
                if (this.model.status === 'Processing') return 'Your Bitcoin is on its way. Waiting for the network to confirm it.';
                return 'Watching the blockchain for your purchase. Nothing to do yet.';
            }
        },
        mounted() {
            this.tzRegion = guessRegion();
            const m = methodFromUrl(this.cfg.methods || []);
            if (m) {
                this.method = m;
                this.focus = true;
                this.applyFocusClasses();
                this.$nextTick(() => {
                    if (this.providers.length) this.pick(this.providers[0].id);
                    const el = document.getElementById('FiatRamp');
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
        },
        methods: {
            asNumber(val) { return val && parseFloat(val.toString().replace(/[^\d.\-]/g, '')); },
            fmt(x) { return (Math.round(x * 100) / 100).toFixed(2); },
            fmtBtc(x) { return (Math.round(x * 1e8) / 1e8).toFixed(8).replace(/0+$/, '').replace(/\.$/, '.0'); },
            select(id) {
                this.method = id;
                this.pick(this.providers.length ? this.providers[0].id : null);
            },
            pick(id) {
                this.activeProvider = id;
                this.slide = 0;
                this.received = '';
                this.showQr = false;
            },
            prev() { if (this.slide > 0) this.slide--; },
            next() { if (this.current && this.slide < this.current.steps.length - 1) this.slide++; },
            touchStart(e) { this.touchX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].clientX : null; },
            touchEnd(e) {
                if (this.touchX === null || !e.changedTouches || !e.changedTouches[0]) return;
                const dx = e.changedTouches[0].clientX - this.touchX;
                this.touchX = null;
                if (dx < -40) this.next(); else if (dx > 40) this.prev();
            },
            enterFocus(id) {
                this.focus = true;
                this.coreOpen = false;
                this.select(id);
                this.applyFocusClasses();
                this.$nextTick(() => {
                    const el = document.getElementById('FiatRamp');
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            },
            toggleCore() {
                this.coreOpen = !this.coreOpen;
                this.applyFocusClasses();
            },
            applyFocusClasses() {
                // The Bitcoin pieces are BTCPay's own markup around this component, so they are shown or hidden by class.
                const box = this.$el && this.$el.parentElement;
                const page = document.getElementById('Checkout');
                for (const el of [box, page]) {
                    if (!el) continue;
                    el.classList.toggle('fiatramp-focus', this.focus);
                    el.classList.toggle('fiatramp-core-open', this.focus && this.coreOpen);
                }
                if (box && this.focus && box.firstElementChild !== this.$el) box.insertBefore(this.$el, box.firstChild);
            },
            buyText() {
                return this.fiatDue > 0 ? `${this.fmt(this.fiatBuy)} ${this.cfg.fiatCurrency}` : `${this.model.due} ${this.model.paymentMethodCurrency}`;
            },
            fill(line) {
                const a = this.model.address || '';
                return (line || '')
                    .replace(/\{buy\}/g, this.buyText())
                    .replace(/\{btc\}/g, `${this.model.due} ${this.model.paymentMethodCurrency}`)
                    .replace(/\{address\}/g, a)
                    .replace(/\{address_short\}/g, a.length > 14 ? `${a.slice(0, 8)}…${a.slice(-6)}` : a)
                    .replace(/\{provider\}/g, this.current ? this.current.name : '');
            },
            copyLabel(key) { return { address: 'Bitcoin address', fiat: 'Amount to buy', btc: 'Amount in BTC' }[key] || key; },
            copyValue(key) {
                if (key === 'address') return this.model.address || '';
                if (key === 'btc') return this.fmtBtc(this.dueBtc);
                return this.fiatDue > 0 ? this.fmt(this.fiatBuy) : this.fmtBtc(this.dueBtc);
            },
            illus(step) {
                const kind = step.copy === 'fiat' ? 'amount' : step.copy === 'address' ? 'address' : step.check ? 'check' : step.open ? 'open' : (step.kind || 'info');
                const text = kind === 'open' ? (this.current ? this.current.name : '') : kind === 'amount' || kind === 'check' ? this.buyText() : kind === 'address' ? (this.model.address || '').slice(0, 18) + '…' : kind === 'signin' ? (this.current ? this.current.name : '') : kind === 'pay' ? `Pay with ${this.methodLabel}` : kind === 'wait' ? 'Bitcoin sent' : '';
                return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(illustration(kind, text));
            },
            href(p) {
                const u = new URL(p.url, location.origin);
                if (this.method) u.searchParams.set('method', this.method);
                u.searchParams.set('region', this.region);
                return u.toString();
            },
            copy(text, key) {
                const value = (text ?? '').toString();
                const done = () => {
                    this.$set(this.copied, key, true);
                    setTimeout(() => this.$set(this.copied, key, false), 1500);
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(value).then(done, done);
                } else {
                    const ta = document.createElement('textarea');
                    ta.value = value; document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); } catch (e) {}
                    document.body.removeChild(ta); done();
                }
            }
        }
    });
})();
</script>
